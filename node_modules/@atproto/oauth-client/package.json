    "@atproto-labs/simple-store": "^0.4.4",
    "@atproto/oauth-types": "^0.7.5",
    "@atproto/did": "^0.5.4",
    "@atproto/xrpc": "^0.8.6",
    "@atproto/jwk": "^0.7.4"
